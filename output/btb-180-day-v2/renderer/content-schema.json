{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Broken to Balanced exact-copy source v1.0",
  "type":"object",
  "required":["schema_version","brand","window_start","window_end","pillars","posts"],
  "properties":{
    "schema_version":{"const":"1.0"},
    "brand":{"const":"Broken to Balanced"},
    "window_start":{"const":"2026-10-28"},
    "window_end":{"const":"2027-04-25"},
    "pillars":{"type":"object","required":["P1","P2","P3","P4","P5","P6"]},
    "posts":{"type":"array","minItems":180,"maxItems":180,"items":{"$ref":"#/$defs/post"}}
  },
  "$defs":{
    "text":{"type":"string","minLength":1},
    "slide":{
      "type":"object","required":["number","text","alt_text"],
      "properties":{"number":{"type":"integer","minimum":1,"maximum":6},"text":{"$ref":"#/$defs/text"},"alt_text":{"$ref":"#/$defs/text"}}
    },
    "post":{
      "type":"object",
      "required":["id","day","planned_date","timezone","pillar_id","series","layout","slides","caption","hashtags","caption_ready_to_copy","visual_brief","copy_sha256","founder_attestation_required","publish_status","primary_cta","performance_actuals"],
      "properties":{
        "id":{"type":"string","pattern":"^BTB-[0-9]{3}$"},
        "day":{"type":"integer","minimum":1,"maximum":180},
        "planned_date":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "timezone":{"const":"America/Toronto"},
        "pillar_id":{"enum":["P1","P2","P3","P4","P5","P6"]},
        "series":{"$ref":"#/$defs/text"},
        "layout":{"enum":["editorial","contrast","script","checklist","letter"]},
        "slides":{"type":"array","minItems":6,"maxItems":6,"items":{"$ref":"#/$defs/slide"}},
        "caption":{"$ref":"#/$defs/text"},
        "hashtags":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"string","pattern":"^#[A-Za-z0-9]+$"}},
        "caption_ready_to_copy":{"$ref":"#/$defs/text"},
        "visual_brief":{"$ref":"#/$defs/text"},
        "copy_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "founder_attestation_required":{"type":"boolean"},
        "publish_status":{"const":"DRAFT — unpublished; owner editorial approval required"},
        "primary_cta":{"enum":["save","share","follow"]},
        "performance_actuals":{"type":"null"}
      }
    }
  }
}
